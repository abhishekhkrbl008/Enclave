// Enclave — prove membership without revealing identity
// Midnight Builder Challenge — Level 3 (First Quarter)
// Idea: Private Allowlist Access
//
// PRIVACY MODEL
//   PUBLIC   : enclave name, room labels, per-room entry counts, the set
//              of spent nullifiers, enclave open/closed status.
//   PRIVATE  : the member's allowlist secret, and any link between a
//              nullifier and the identity that entered a room.
//   PROVED WITHOUT REVEALING: that the caller's secret is a member of
//              the trusted allowlist and has not entered this specific
//              room before — without revealing which member, or which
//              other rooms they've entered.

pragma language_version >= 0.16;

import CompactStandardLibrary;

// ---------------------------------------------------------------------
// Ledger (PUBLIC on-chain state)
// ---------------------------------------------------------------------

export ledger enclaveName: Opaque<"string">;
export ledger roomLabels: Vector<3, Opaque<"string">>;
export ledger roomCount: Uint<8>;
export ledger roomVisits: Map<Uint<8>, Field>;   // roomIndex -> entry count
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger allowlistRoot: Bytes<32>;             // Merkle root of member leaves
export ledger isOpen: Boolean;

// ---------------------------------------------------------------------
// Witnesses (PRIVATE — supplied locally by the member)
// ---------------------------------------------------------------------

witness memberSecret(): Bytes<32>;
witness memberPath(): MerkleTreePath<10, Bytes<32>>;

// ---------------------------------------------------------------------
// Circuits
// ---------------------------------------------------------------------

// Convener opens the enclave with 1-3 named rooms and publishes the
// Merkle root of every allowlisted member's hashed secret.
constructor(
  name: Opaque<"string">,
  labels: Vector<3, Opaque<"string">>,
  numRooms: Uint<8>,
  root: Bytes<32>
): [] {
  assert(numRooms >= 1 && numRooms <= 3, "enclave needs 1-3 rooms");
  enclaveName = disclose(name);
  roomLabels = disclose(labels);
  roomCount = disclose(numRooms);
  allowlistRoot = disclose(root);
  isOpen = true;
  for (const i of 0..3) {
    if ((i as Uint<8>) < disclose(numRooms)) {
      roomVisits.insert(disclose(i as Uint<8>), 0);
    }
  }
}

// A member proves, in zero-knowledge:
//   1) their secret hashes into a leaf that is a member of allowlistRoot
//   2) the room-scoped nullifier derived from that secret has not been
//      used before (one entry per member per room, ever)
// Only the room's PUBLIC visit counter is incremented. No membership
// leaf, room-visit history, or identity is ever written to the ledger.
export circuit enterRoom(roomIndex: Uint<8>): [] {
  const publicRoomIndex = disclose(roomIndex);
  assert(isOpen, "enclave is closed");
  assert(publicRoomIndex < roomCount, "no such room");

  const secret = memberSecret();
  const path = memberPath();

  const leaf = persistentHash<Bytes<32>>(secret);
  assert(path.leaf == leaf, "path leaf does not match secret");
  const computedRoot = merkleTreePathRoot<10, Bytes<32>>(path);
  assert(upgradeFromTransient(computedRoot.field) == allowlistRoot, "not on the allowlist");

  const nullifier = disclose(persistentHash<Vector<3, Bytes<32>>>(
    [
      secret,
      allowlistRoot,
      persistentHash<Uint<8>>(publicRoomIndex)
    ]
  ));
  assert(!usedNullifiers.member(nullifier), "already entered this room");
  usedNullifiers.insert(nullifier);

  const current = roomVisits.lookup(publicRoomIndex);
  roomVisits.insert(publicRoomIndex, current + 1);
}

// Convener closes the enclave. Past entries remain recorded; no further
// entries are accepted.
export circuit closeEnclave(): [] {
  assert(isOpen, "already closed");
  isOpen = false;
}
